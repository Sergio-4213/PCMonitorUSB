<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background" android:orientation="vertical" android:padding="7dp"
    tools:ignore="ButtonStyle,HardcodedText,NestedWeights">

    <LinearLayout android:layout_width="match_parent" android:layout_height="38dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="31dp" android:layout_height="31dp" android:layout_marginEnd="8dp" android:contentDescription="PC Monitor USB" android:src="@mipmap/ic_launcher" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:text="@string/app_header_landscape" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/connection_status" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:text="● USB" android:textColor="@color/normal" android:textSize="12sp" android:textStyle="bold" />
        <Button android:id="@+id/menu_button" android:layout_width="38dp" android:layout_height="38dp" android:background="@android:color/transparent" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" android:text="⋮" android:textColor="@color/text_primary" android:textSize="22sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/mode_bar" android:layout_width="match_parent" android:layout_height="34dp" android:orientation="horizontal">
        <Button android:id="@+id/mode_monitor" android:layout_width="112dp" android:layout_height="match_parent" android:layout_marginEnd="3dp" android:background="@drawable/mode_selected" android:minHeight="0dp" android:text="@string/mode_monitor" android:textColor="@color/accent" android:textSize="11sp" android:textStyle="bold" />
        <Button android:id="@+id/mode_control" android:layout_width="112dp" android:layout_height="match_parent" android:layout_marginStart="3dp" android:background="@drawable/mode_unselected" android:minHeight="0dp" android:text="@string/mode_control" android:textColor="@color/text_secondary" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:id="@+id/message" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="@color/critical" android:textSize="11sp" />
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingTop="4dp">
        <LinearLayout android:id="@+id/monitor_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
            <LinearLayout android:id="@+id/sensor_area" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:baselineAligned="false" android:orientation="horizontal">
                <LinearLayout android:id="@+id/cpu_card" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="@drawable/panel_background" android:orientation="vertical" android:padding="10dp">
                    <TextView android:id="@+id/cpu_name" style="@style/MetricTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:text="CPU" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:id="@+id/cpu_temp" style="@style/MetricLarge" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="--°C" />
                        <TextView android:id="@+id/cpu_usage" style="@style/MetricLarge" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="--%" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/cpu_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:id="@+id/cpu_clock" style="@style/MetricSmall" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="-- GHz" />
                        <TextView android:id="@+id/cpu_power" style="@style/MetricSmall" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="-- W" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:id="@+id/gpu_card" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="2dp" android:background="@drawable/panel_background" android:orientation="vertical" android:padding="10dp">
                    <TextView android:id="@+id/gpu_name" style="@style/MetricTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:text="GPU" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:id="@+id/gpu_temp" style="@style/MetricLarge" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="--°C" />
                        <TextView android:id="@+id/gpu_usage" style="@style/MetricLarge" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="--%" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/gpu_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:id="@+id/gpu_hotspot" style="@style/MetricSmall" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="HOTSPOT --°C" /><TextView android:id="@+id/gpu_power" style="@style/MetricSmall" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="-- W" /></LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:id="@+id/gpu_clock" style="@style/MetricSmall" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="CORE -- MHz" /><TextView android:id="@+id/gpu_vram_clock" style="@style/MetricSmall" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="VRAM -- MHz" /></LinearLayout>
                        <TextView android:id="@+id/gpu_fan" style="@style/MetricSmall" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="FAN -- RPM / --%" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/memory_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/panel_background" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="horizontal">
                        <TextView style="@style/MetricTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RAM" />
                        <TextView android:id="@+id/ram_value" style="@style/MetricSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:text="-- / -- GB" />
                        <TextView android:id="@+id/ram_usage" style="@style/MetricSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:text="--%" />
                    </LinearLayout>
                    <View android:layout_width="1dp" android:layout_height="28dp" android:background="@color/line" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="horizontal">
                        <TextView style="@style/MetricTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="VRAM" />
                        <TextView android:id="@+id/vram_value" style="@style/MetricSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:text="-- / -- GB" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal">
                    <LinearLayout android:id="@+id/network_group" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal" android:visibility="gone"><TextView android:id="@+id/download_value" style="@style/MetricSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="↓ -- MB/s" /><TextView android:id="@+id/upload_value" style="@style/MetricSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:text="↑ -- MB/s" /></LinearLayout>
                    <LinearLayout android:id="@+id/disk_group" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal" android:visibility="gone"><TextView android:id="@+id/disk_activity" style="@style/MetricSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/disk_value" /><TextView android:id="@+id/disk_usage" style="@style/MetricSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:text="@string/usage_value" /></LinearLayout>
                    <LinearLayout android:id="@+id/fps_group" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:visibility="gone"><TextView style="@style/MetricTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FPS " /><TextView android:id="@+id/fps_value" style="@style/MetricSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" /></LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/control_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:baselineAligned="false" android:orientation="horizontal" android:visibility="gone">
            <LinearLayout android:layout_width="218dp" android:layout_height="match_parent" android:orientation="vertical" android:paddingEnd="5dp">
                <TextView android:layout_width="match_parent" android:layout_height="26dp" android:gravity="center" android:text="@string/live_summary" android:textColor="@color/accent" android:textSize="11sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/panel_background" android:gravity="center" android:orientation="vertical" android:padding="9dp">
                    <TextView style="@style/ControlSummaryTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="CPU" /><TextView android:id="@+id/control_cpu_value" style="@style/ControlSummaryValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="--°C  •  --%" /><TextView android:id="@+id/control_cpu_details" style="@style/MetricSmall" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="-- GHz  •  -- W" />
                    <TextView style="@style/ControlSummaryTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center" android:text="GPU" /><TextView android:id="@+id/control_gpu_value" style="@style/ControlSummaryValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="--°C  •  --%" /><TextView android:id="@+id/control_gpu_details" style="@style/MetricSmall" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="-- MHz  •  -- W" />
                    <TextView android:id="@+id/control_ram_value" style="@style/MetricSmall" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="RAM  -- / -- GB" /><TextView android:id="@+id/control_vram_value" style="@style/MetricSmall" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="VRAM  -- / -- GB" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="26dp" android:gravity="center" android:text="@string/computer_controls" android:textColor="@color/accent" android:textSize="11sp" android:textStyle="bold" />
                <GridLayout android:id="@+id/button_grid" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:columnCount="7" android:orientation="horizontal" android:padding="2dp">
                    <Button android:id="@+id/cmd_media_previous" style="@style/PanelButton" android:text="@string/previous" /><Button android:id="@+id/cmd_media_play_pause" style="@style/PanelButton" android:text="PLAY/PAUSE" /><Button android:id="@+id/cmd_media_next" style="@style/PanelButton" android:text="@string/next" /><Button android:id="@+id/cmd_mute" style="@style/PanelButton" android:text="MUTE" /><Button android:id="@+id/cmd_volume_down" style="@style/PanelButton" android:text="VOL -" /><Button android:id="@+id/cmd_volume_up" style="@style/PanelButton" android:text="VOL +" /><Button android:id="@+id/cmd_show_desktop" style="@style/PanelButton" android:text="DESKTOP" />
                    <Button android:id="@+id/cmd_open_task_manager" style="@style/PanelButton" android:text="@string/task_manager" /><Button android:id="@+id/cmd_open_steam" style="@style/PanelButton" android:text="STEAM" /><Button android:id="@+id/cmd_open_amd" style="@style/PanelButton" android:text="AMD" /><Button android:id="@+id/cmd_custom_1" style="@style/PanelButton" android:text="CUSTOM 1" /><Button android:id="@+id/cmd_custom_2" style="@style/PanelButton" android:text="CUSTOM 2" /><Button android:id="@+id/cmd_custom_3" style="@style/PanelButton" android:text="CUSTOM 3" /><Button android:id="@+id/cmd_custom_4" style="@style/PanelButton" android:text="CUSTOM 4" />
                </GridLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/wake_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/panel_background" android:gravity="center" android:orientation="horizontal" android:padding="24dp" android:visibility="gone">
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/pc_offline" android:textColor="@color/text_secondary" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/wake_computer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:text="PC" android:textColor="@color/text_primary" android:textSize="21sp" android:textStyle="bold" />
                <TextView android:id="@+id/wake_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:maxLines="3" android:text="@string/wake_instructions" android:textColor="@color/text_secondary" android:textSize="12sp" />
            </LinearLayout>
            <Button android:id="@+id/wake_button" android:layout_width="250dp" android:layout_height="92dp" android:layout_marginStart="24dp" android:background="@drawable/wake_button_background" android:minHeight="0dp" android:minWidth="0dp" android:text="@string/turn_pc_on" android:textColor="@color/text_primary" android:textSize="19sp" android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
